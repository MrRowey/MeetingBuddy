<Window x:Class="MeetingBuddy.AlertWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="560" Height="320" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" WindowStartupLocation="Manual" Background="Transparent" Foreground="#202124" FontFamily="Segoe UI Variable, Segoe UI">
 <Border x:Name="Frame" Background="White" BorderBrush="#D64545" BorderThickness="2.5" CornerRadius="20" Padding="28">
  <Border.Effect>
   <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.27"/>
  </Border.Effect>
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border x:Name="BadgeBorder" Background="#FDE8E8" CornerRadius="8" Padding="10,5">
     <TextBlock x:Name="BadgeText" Text="●  MEETING BUDDY  /  REMINDER" Foreground="#B42318" FontSize="11" FontWeight="Bold"/>
    </Border>
    <TextBlock x:Name="LiveHintText" Grid.Column="1" Text="Live meeting — remains active until joined or acknowledged" Foreground="#B42318" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
   </Grid>

   <StackPanel Grid.Row="1" VerticalAlignment="Center">
    <TextBlock x:Name="MeetingTitle" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,8"/>
    <TextBlock x:Name="MeetingTime" FontSize="15" Foreground="#667085" TextWrapping="Wrap"/>
   </StackPanel>

   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="JoinButton" Content="Join Zoom" Click="Join_Click" Visibility="Collapsed" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Padding="16,9" Margin="0,0,10,0"/>
    <Button x:Name="SnoozeButton" Content="Snooze 2 min" Click="Snooze_Click" Padding="14,9" Margin="0,0,10,0"/>
    <Button x:Name="AcknowledgeButton" Content="Acknowledge" Click="Acknowledge_Click" Visibility="Collapsed" Padding="14,9" Margin="0,0,10,0"/>
    <Button x:Name="DismissButton" Content="Dismiss" Click="Dismiss_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Padding="16,9" Margin="0"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>